<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- HEADER -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#3F51B5"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_centerVertical="true" />

    </RelativeLayout>


    <!-- TITLE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Cars"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_margin="20dp" />


    <!-- BMW -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_margin="10dp"
        android:padding="15dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvCar1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BMW Serie 3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120 TND / day"
            android:layout_below="@id/tvCar1"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCar1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOK"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>


    <!-- MERCEDES -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_margin="10dp"
        android:padding="15dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvCar2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mercedes Class A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150 TND / day"
            android:layout_below="@id/tvCar2"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCar2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOOK"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

</LinearLayout>